# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
# BCrypt hash de ADMIN_PASSWORD. OBLIGATORIO fuera del perfil local (el
# api-gateway no arranca sin él). Generar con:
#   htpasswd -bnBC 10 "" 'your_secure_password_here' | tr -d ':\n'
# (obtén también SESSION_SECRET, ver abajo)
ADMIN_PASSWORD_BCRYPT=

# HMAC Session Secret (32 bytes, compartido por gateway/reporting/territory)
# Generar con: openssl rand -hex 32
SESSION_SECRET=

# PostgreSQL Database (Neon)
# Pooled connection (with -pooler suffix): Use for application queries (HikariCP)
# Direct connection (without -pooler): Use for Flyway migrations, pg_dump, replication
#
# Neon provides two endpoints:
#   DB_URL          = pooled endpoint (-pooler in hostname) → for app traffic
#   DB_URL_UNPOOLED = direct endpoint (no -pooler)         → for migrations
#
# Do NOT embed user/password in the URL — pass them via DB_USERNAME/DB_PASSWORD.
#
# Example Neon connection strings (replace with your actual endpoint):
#   DB_URL=jdbc:postgresql://ep-cool-darkness-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require
#   DB_URL_UNPOOLED=jdbc:postgresql://ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require
#
# For local Docker development, use the postgres container:
DB_URL=jdbc:postgresql://postgres:5432/predicador
DB_URL_UNPOOLED=jdbc:postgresql://postgres:5432/predicador
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Eureka Service Discovery
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://localhost:8761/eureka/

# Config Server
SPRING_CLOUD_CONFIG_URI=http://localhost:8888

# CORS (API Gateway)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Cookie Security (set to false for local HTTP development)
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_SECURE=false

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_DESTINATION=
WHATSAPP_LANG=es_CL

# RabbitMQ (used by territory-service, reporting-service, and rabbitmq broker)
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Grafana (observability profile)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
