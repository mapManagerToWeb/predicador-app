<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.predicador</groupId>
        <artifactId>predicador-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>discovery-server</artifactId>
    <name>Discovery Server</name>
    <description>Eureka Service Discovery Server</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
            CVE-2026-102554 (HIGH) in the Guava version Eureka Server pulls in
            transitively. It is declared here, explicitly and with a version,
            for two reasons:

            1. Trivy also reads the pom.xml embedded in the jar. That pom
               carries no parent, so Trivy cannot see the dependencyManagement
               override in the root pom and keeps resolving the transitive
               33.0.0-jre. Naming the version here is what makes the image scan
               green, and it is the same version the build already resolves.
            2. A direct, compile-scoped dependency is visible to the Enforcer,
               which does not evaluate runtime-scope artifacts.

            Keep it in sync with the entry in the root pom's
            dependencyManagement and with the Enforcer floor.
        -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.8.0-jre</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
