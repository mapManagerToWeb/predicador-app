<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.predicador</groupId>
    <artifactId>predicador-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Predicador Backend</name>
    <description>Backend microservices for Predicador PWA</description>

    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.4</spring-cloud.version>
        <springdoc.version>3.1.0</springdoc.version>
        <testcontainers.version>1.20.1</testcontainers.version>
        <netty.version>4.2.17.Final</netty.version>
        <tomcat.version>11.0.25</tomcat.version>
        <!--
            Observability stack. OpenTelemetry Spring Boot starter uses the
            OTel BOM to align every otel-* artifact on the same generation.
            logstash-logback-encoder emits JSON logs with MDC (traceId/spanId
            injected by Micrometer Tracing) so Grafana Loki / any log collector
            can correlate logs with traces without regex parsing.
        -->
        <opentelemetry.version>1.64.0</opentelemetry.version>
        <opentelemetry-instrumentation.version>2.31.0</opentelemetry-instrumentation.version>
        <logstash-logback.version>8.0</logstash-logback.version>
        <!--
            Transitive dependency overrides for CVEs that the managed versions
            shipped by Spring Boot do not yet fix. Every value here must be
            consumed by a real dependencyManagement entry below: an unused
            property overrides nothing (this bit us on amqp-client).
        -->
        <httpcore5.version>5.4.3</httpcore5.version>
        <!--
            5.37.0 es el primer release publicado con los tres avisos cerrados
            (el 5.36.1 que cita el aviso de Dependabot nunca se publicó). 5.37.1
            es el último parche de esa línea y mantiene compatibilidad con
            spring-rabbit 4.1.1.
        -->
        <rabbit-amqp-client.version>5.37.1</rabbit-amqp-client.version>
        <!--
            Found by the Trivy image scan (see docs/adr/0015-baseline-deps-contra-cves.md).
            All five of these were shipping CRITICAL/HIGH CVEs in every published
            image; the pins below are the minimum fixed release on each existing
            minor line, so no cross-minor upgrade is introduced.
        -->
        <bouncycastle.version>1.85</bouncycastle.version>
        <jackson2.version>2.21.7</jackson2.version>
        <jackson3.version>3.1.7</jackson3.version>
        <freemarker.version>2.3.35</freemarker.version>
    </properties>

    <modules>
        <module>shared</module>
        <module>config-server</module>
        <module>discovery-server</module>
        <module>api-gateway</module>
        <module>territory-service</module>
        <module>reporting-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom</artifactId>
                <version>${opentelemetry-instrumentation.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Transitive dependency overrides for known CVEs that the managed
                versions shipped by Spring Boot / Spring Cloud do not yet fix.
                Each entry names the CVE it closes; re-check with
                `npx trivy image` at severity HIGH,CRITICAL after bumping.
            -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.12</version>
            </dependency>
            <!--
                CVE-2026-102554 (HIGH, DoS via unthrottled memory allocation
                while deserializing). Only discovery-server ships Guava: it
                arrives through the Eureka server and lands in the image at
                33.0.0-jre. Fixed in 33.7.2; 33.8.0-jre is the current patch on
                that line. Trivy is what guards this pin — the artifact is
                runtime-scoped, so the Enforcer cannot see it (see the
                bannedDependencies comment).
            -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.8.0-jre</version>
            </dependency>
            <!--
                CVE-2026-8763 (CRITICAL, Name Constraints bypass via trailing dot)
                and CVE-2026-13506 (HIGH, DoS via lazy ASN.1 sequence) in
                bcprov-jdk18on, shipped in all five images. Fixed in 1.85.
            -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <!--
                Jackson 2.x line: CVE-2026-89407, CVE-2026-89425,
                CVE-2026-68497, CVE-2026-91776, CVE-2026-91777 (all HIGH:
                unbounded memory growth / quadratic parsing on hostile input).
                2.21.7 is the minimum release on the 2.21 line closing all five.
            -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Jackson 3.x line (tools.jackson), same five CVEs. Spring Boot 4
                ships this line alongside 2.x, so both need pinning or one stays
                vulnerable.
            -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                CVE-2026-84939 (CRITICAL, path traversal) in FreeMarker, pulled
                into discovery-server by spring-boot-starter-freemarker.
            -->
            <dependency>
                <groupId>org.freemarker</groupId>
                <artifactId>freemarker</artifactId>
                <version>${freemarker.version}</version>
            </dependency>
            <!--
                CVE-2026-75516 (HIGH, DoS) in the RabbitMQ client used by
                reporting-service. The version property above existed but was
                never wired to an entry here, so it silently did nothing;
                this entry is what actually pins it.
            -->
            <dependency>
                <groupId>com.rabbitmq</groupId>
                <artifactId>amqp-client</artifactId>
                <version>${rabbit-amqp-client.version}</version>
            </dependency>
            <!-- Spring Cloud Config Server 5.0.0 has CVEs (CVE-2026-40982 CRITICAL, CVE-2026-22739 HIGH, CVE-2026-40981 HIGH, CVE-2026-41002 HIGH). Fixed in 5.0.3. -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-config-server</artifactId>
                <version>5.0.6</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Compuerta de seguridad del reactor: falla el build si una
                dependencia vuelve a una versión con CVE conocido. Es lo que
                impide que un bump accidental (o un módulo nuevo) reintroduzca
                la versión vulnerable que arreglamos aquí.

                Se ejecuta en `validate`, antes de compilar, así el fallo llega
                en segundos y no después de una suite completa.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>enforce-dependency-floors</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!--
                                            Un piso por cada pin por CVE de
                                            `dependencyManagement`. El pin solo
                                            vale mientras nadie lo pise; esto lo
                                            hace imposible. El piso es la
                                            versión ya pinneada, así que no
                                            prohíbe nada que hoy se resuelva:
                                            si un módulo nuevo arrastra una
                                            versión menor, el build falla en
                                            `validate` y no en producción.

                                            Sólo aparecen aquí los artefactos que
                                            el Enforcer ve de verdad. Se probó
                                            subiendo cada techo por encima de la
                                            versión resuelta: muerde en
                                            compile-scope, pero NO ve
                                            `org.postgresql:postgresql` porque se
                                            resuelve en scope runtime. Ese pin lo
                                            cubren Trivy y OWASP dependency-check
                                            en CI, no esta regla: no lo agregues
                                            aquí para no simular una protección
                                            que no existe.
                                        -->
                                        <!--
                                            amqp-client: credenciales en el
                                            mensaje de excepción <= 5.34.0,
                                            shortstr malformado <= 5.35.0,
                                            JSONReader sin fin ante entrada
                                            truncada <= 5.36.0. El primer
                                            release publicado con los tres
                                            arreglos es 5.37.0 (5.36.1, que
                                            cita el aviso, nunca se publicó).
                                        -->
                                        <exclude>com.rabbitmq:amqp-client:[,5.37.0)</exclude>
                                        <!-- CVE-2026-8763 / CVE-2026-13506 -->
                                        <exclude>org.bouncycastle:bcprov-jdk18on:[,1.85)</exclude>
                                        <!-- CVE-2026-102554 (solo discovery-server,
                                             declarado directo en su pom) -->
                                        <exclude>com.google.guava:guava:[,33.7.2)</exclude>
                                        <!-- Jackson 2.x: cinco CVE de parsing -->
                                        <exclude>com.fasterxml.jackson.core:jackson-databind:[,2.21.7)</exclude>
                                        <exclude>com.fasterxml.jackson.core:jackson-core:[,2.21.7)</exclude>
                                        <!-- Jackson 3.x (tools.jackson), mismos CVE -->
                                        <exclude>tools.jackson.core:jackson-databind:[,3.1.7)</exclude>
                                        <!-- CVE-2026-84939 -->
                                        <exclude>org.freemarker:freemarker:[,2.3.35)</exclude>
                                        <!-- CVE-2026-40982 / 22739 / 40981 / 41002 -->
                                        <exclude>org.springframework.cloud:spring-cloud-config-server:[,5.0.5)</exclude>
                                        <!-- Pin de httpcore5 -->
                                        <exclude>org.apache.httpcomponents.core5:httpcore5:[,5.4.3)</exclude>
                                        <exclude>org.apache.httpcomponents.core5:httpcore5-h2:[,5.4.3)</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.14</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.40</minimum>
                                                </limit>
                                                <limit>
                                                    <counter>INSTRUCTION</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.40</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
